# Local dev reference only — this project has no Node server, so these are
# never read by `next dev`. Real values are set as Cloudflare Worker secrets:
#   npx wrangler secret put STRIPE_SECRET_KEY
# Never commit real values. See worker.ts for how each is used.

# Stripe secret key (test mode first: sk_test_...). Required for /api/checkout
# to create real Checkout Sessions — without it the endpoint returns 503.
STRIPE_SECRET_KEY=

# Optional overrides — public-safe defaults are already hardcoded in worker.ts.
SUPABASE_URL=
SUPABASE_ANON_KEY=
