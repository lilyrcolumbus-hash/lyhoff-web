{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Cloudflare Workers + Static Assets (same model as kdp-book-factory).
  // `npm run build` produces ./out (static export). The Worker (worker.ts) only
  // runs on asset misses — it handles POST /api/subscribe (newsletter → Resend)
  // and otherwise serves the static site via the ASSETS binding.
  "name": "lyhoff-web",
  "compatibility_date": "2026-05-22",
  "main": "worker.ts",
  "assets": {
    "directory": "./out",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    // Without this, Cloudflare's asset router answers browser NAVIGATION
    // requests itself (Sec-Fetch-Mode: navigate) and serves the 404 page before
    // worker.ts ever sees them. fetch()/XHR calls fall through fine, which is
    // why every /api route appeared to work while a link clicked out of an
    // email 404'd. Anything under /api must reach the Worker first.
    "run_worker_first": ["/api/*"]
  }
}
